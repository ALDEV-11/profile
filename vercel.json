{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": ["sin1"],
    "services": {
        "app": {
            "root": ".",
            "entrypoint": "Dockerfile",
            "runtime": "container"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ],
    "crons": [
        {
            "path": "/cron/visitors-cleanup",
            "schedule": "0 3 * * *"
        }
    ]
}
